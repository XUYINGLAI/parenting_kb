# Copy to .env and replace examples with your own configuration.
# No real credentials belong in this file.

# MinerU
MINERU_TOKEN=

# OpenAI-compatible chat and vision endpoint
OPENAI_API_KEY=
OPENAI_API_BASE=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-plus
ITEM_MODEL=qwen-plus
VL_MODEL=qwen-vl-plus
LLM_DEFAULT_TEMPERATURE=0.2

# Local BGE-M3 model
BGE_M3_PATH=D:/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False

# Milvus
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# MinIO: create the bucket and configure image access separately
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=upload-images

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=parenting_kb
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# Network search MCP: replace with the service you use
MCP_BASE_URL=https://YOUR_MCP_ENDPOINT
MCP_API_KEY=

# DashScope text rerank (match endpoint, model and credentials)
RERANK_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
